# Copy to .env for local development. These values are local placeholders only.
APP_ENV=development
POSTGRES_USER=dressme
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_DB=dressme
DATABASE_URL=postgresql+psycopg://dressme:local-development-only-change-me@postgres:5432/dressme
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
BO6_SERVICE_URL=http://ml-service:8000
STORAGE_PATH=/srv/data/private-images
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
PENDING_UPLOAD_TTL_SECONDS=3600
REDIS_URL=redis://redis:6379/0
VTON_MODE=mock
MAX_PERSON_PHOTOS=10
MAX_OUTSTANDING_JOBS=3
MAX_QUEUED_JOBS=200
BACKEND_PORT=8000
FRONTEND_PORT=8080
