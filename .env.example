# Copy once to .env. Keep database passwords, pepper and SMTP credentials local.
APP_ENV=development
APP_PORT=8001
BO6_PORT=18022

# Local SQLite database. Keep this file and private images when updating code.
DATABASE_URL=sqlite:///./var/dressme.sqlite
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001
JWT_SECRET=

# Point storage at a private persistent directory; the repository-relative
# defaults are ignored by Git and suitable only for local development.
STORAGE_PATH=./var/private-images
EMAIL_CAPTURE_PATH=./var/mail-capture

# The backend reaches this separate local service. The BO6 process receives an
# absolute bundle path from scripts/dev/start.ps1 or the operator's shell.
BO6_SERVICE_URL=http://127.0.0.1:18022
MODEL_BUNDLE_DIR=./bo6_service/bundle

# Optional MOCK queue. Real VTON is unavailable in this checkout.
VTON_MODE=mock
REDIS_URL=redis://127.0.0.1:6379/0
TRYON_QUEUE_NAME=try-on

# Optional Avaturn integration; configure only approved HTTPS origins.
AVATURN_URL=
AVATURN_EXPORT_ORIGINS=

# Local recovery uses private .eml capture. Configure SMTP privately to deliver.
PASSWORD_RESET_PEPPER=development-only-change-before-deploy
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_ATTEMPT_LIMIT=5
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_RATE_LIMIT_COUNT=10
PASSWORD_RESET_RATE_WINDOW_SECONDS=900
EMAIL_DELIVERY_MODE=capture
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10

# Public API integrations from the original five pages; optional.
SERPAPI_KEY=
IMGBB_KEY=

# Local BO1/BO5 assistant

# Keep an existing hf_syrine value. Never add a second token variable.
hf_syrine=""
DRESSME_BO1_DIR=bo1/score
DRESSME_PARSER_ADAPTER=bo5/parser_for_local/parser_adapter
DRESSME_PARSER_PRECISION=nf4
DRESSME_PARSER_DEVICE=cuda:0
DRESSME_RAG_MODE=hybrid
DRESSME_ALLOW_DOWNLOADS=1
DRESSME_RANKING_WEIGHTS=0.65,0.25,0.10
DRESSME_POOL_PER_ROLE=8
