  "version": "pad-resize-v2",
  "image_size": 224,
  "pad_to_square": true,
  "pad_fill": [
    255,
    255,
    255
  ],
  "resize": "bilinear, antialias",
  "to_rgb": true,
  "exif_transpose": true,
  "mean": [
    0.485,
