  "eval_pipeline": "exif_transpose -> RGB -> pad to square -> resize SxS -> ToTensor -> Normalize",
  "train_augment": "hflip 0.5, rotation +-8deg @0.3, colour jitter (0.15, 0.10, 0.10)",
  "note": "identical for every architecture; no centre crop"
